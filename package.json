{
  "name": "react-cosmic",
  "version": "1.2.0",
  "description": "React state that persists across refreshes, syncs across tabs, and survives crashes",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --external react --external yjs --external y-websocket",
    "test": "vitest",
    "test:file": "vitest run",
    "test:examples": "cd examples/basic-form && bun run build && cd ../websocket-sync && bun run build",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "hooks:install": "lefthook install --reset-hooks-path",
    "hooks:run:pre-push": "lefthook run pre-push",
    "release": "bash scripts/release.sh",
    "release:tag": "bash scripts/release-tag.sh",
    "docs": "typedoc src/index.ts",
    "demo": "bun --hot examples/basic-form/index.html",
    "demo:collab": "bun --hot examples/websocket-sync/index.html",
    "demo:server": "bunx y-websocket-server --port 1234"
  },
  "keywords": [
    "react",
    "state-management",
    "persist",
    "persistence",
    "localstorage",
    "indexeddb",
    "offline-first",
    "cross-tab",
    "tab-sync",
    "sync",
    "crdt",
    "yjs",
    "collaboration",
    "multiplayer",
    "real-time",
    "realtime"
  ],
  "author": "James Glenn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JR-G/react-cosmic.git"
  },
  "homepage": "https://github.com/JR-G/react-cosmic#readme",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/bun": "^1.3.5",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^10.1.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.5.0",
    "lefthook": "^2.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsdown": "^0.21.7",
    "typedoc": "^0.28.16",
    "typescript": "^6.0.2",
    "vitest": "^4.0.18"
  }
}
